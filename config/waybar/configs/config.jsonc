{
    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,

    "modules-left": [
        "custom/desk1",
        "custom/desk2",
        "custom/desk3",
        "custom/desk4"
    ],
    "modules-center": ["clock"],
    "modules-right": [
        "cpu",
        "temperature",
        "memory",
        "network",
        "bluetooth",
        "backlight",
        "pulseaudio",
        "battery",
        "custom/power"
    ],

    // --- LEFT (GLOBAL WORKSPACES) ---
    "custom/desk1": {
        "format": " 1 ",
        "on-click": "hyprctl --batch 'dispatch workspace 11; dispatch workspace 1'",
        "tooltip": false
    },
    "custom/desk2": {
        "format": " 2 ",
        "on-click": "hyprctl --batch 'dispatch workspace 12; dispatch workspace 2'",
        "tooltip": false
    },
    "custom/desk3": {
        "format": " 3 ",
        "on-click": "hyprctl --batch 'dispatch workspace 13; dispatch workspace 3'",
        "tooltip": false
    },
    "custom/desk4": {
        "format": " 4 ",
        "on-click": "hyprctl --batch 'dispatch workspace 14; dispatch workspace 4'",
        "tooltip": false
    },

    // A partir de aquí deja tus otros módulos (clock, cpu, etc.)...

    // --- CENTER ---
    "clock": {
        "interval": 1,
        "format": " {:%H:%M:%S %p |   %d/%m/%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    // --- RIGHT ---
    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "tooltip": false
    },
    
    "memory": {
        "interval": 2,
        "format": " {percentage}%",
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "Network: {essid}\nSignal: {signalStrength}%",
        "on-click": "~/.config/hypr/scripts/rofi-wifi.sh"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-connected": "",
        "format-off": "",
        "format-on": "",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", ""],
        "scroll-step": 5
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " {volume}%",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {icon} {capacity}%",
        "format-plugged": " {icon} {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "wlogout"
    }
}
