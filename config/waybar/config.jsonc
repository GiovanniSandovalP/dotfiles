{
    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
        "cpu",
        "temperature",
        "memory",
        "network",
        "bluetooth",
        "backlight",
        "pulseaudio",
        "battery",
        "custom/power"
    ],

    // --- LEFT ---
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "disable-scroll": true,
        "all-outputs": true
    },

    // --- CENTER ---
    "clock": {
        "interval": 1,
        "format": " {:%H:%M:%S |  %d/%m/%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    // --- RIGHT ---
    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "tooltip": false
    },
    
    "memory": {
        "interval": 2,
        "format": " {percentage}%",
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "⚠",
        "tooltip-format-wifi": "Network: {essid}\nSignal: {signalStrength}%",
        "on-click": "nm-connection-editor" // Requires network-manager-applet installed
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager" // Requires blueman installed
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "scroll-step": 5
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol" // Opens on click
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {icon} {capacity}%",
        "format-plugged": " {icon} {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "wlogout" // We will install wlogout for the power menu later
    }
}
