@import "default"
@import "themes/current.rasi"

configuration {
    modi: "dmenu";
    show-icons: true;
}

window {
    location: center;
    anchor: center;
    width: 90%;
    
    background-color: @bg;
    border: 2px;
    border-color: @border-col;
    border-radius: 16px;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    children: [ listview ];
}

inputbar {
    enabled: false;
}

listview {
    background-color: transparent;
    layout: horizontal;
    lines: 5;
    spacing: 16px;
    cycle: true;
    dynamic: true;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-icon {
    background-color: transparent;
    size: 160px;
    horizontal-align: 0.5;
}

element normal.normal, element alternate.normal {
    background-color: @element-bg;
    text-color: @fg;
    orientation: vertical;
    padding: 12px;
    border-radius: 12px;
    spacing: 8px;
}

element selected.normal {
    background-color: @selected-bg;
    text-color: @selected-fg;
    border: 2px;
    border-color: @bright;
    orientation: vertical;
    padding: 12px;
    border-radius: 12px;
    spacing: 8px;
}
